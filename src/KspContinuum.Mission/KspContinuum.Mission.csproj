<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>KspContinuum.Mission</AssemblyName>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <ProjectReference Include="../KspContinuum.Plugin/KspContinuum.Plugin.csproj" Private="false" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp"><HintPath>$(KSP_MANAGED)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KSP_MANAGED)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KSP_MANAGED)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(KSP_MANAGED)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(KSP_MANAGED)/UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MechJeb2"><HintPath>$(MECHJEB_DLL)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckMissionReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MECHJEB_DLL)')" Text="Set MECHJEB_DLL to the CKAN installed MechJeb2 2.15.3.0 DLL. Build does not install or launch anything." />
  </Target>
</Project>
